{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      { "tsconfig": "<rootDir>/tsconfig.spec.json" }
    ]
  },
  "transformIgnorePatterns": ["/node_modules/(?!nanoid/)"],
  "moduleNameMapper": {
    "^@faker-js/faker$": "<rootDir>/mocks/faker.ts",
    "^(\\.{1,2}/.*)\\.js$": "$1"
  }
}
