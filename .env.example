# Base de datos PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/koliskit?schema=public"

# Puerto del servidor
PORT=3000

# Entorno: development | production
NODE_ENV=development

# Secreto para hashear IPs en analytics (cambiar en producción)
IP_HASH_SECRET="cambia-esto-en-produccion"

# Base pública usada para construir las URLs cortas (sin slash final)
PUBLIC_BASE_URL="http://localhost:3000"
